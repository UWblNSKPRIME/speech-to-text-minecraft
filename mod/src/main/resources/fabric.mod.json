{
  "schemaVersion": 1,
  "id": "vocatalk",
  "version": "${version}",
  "name": "vocatalk",
  "description": "Voice chat input: streams transcript drafts to a HUD overlay and sends final transcripts to chat.",
  "authors": [
    "vocatalk contributors"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.vocatalk.VocaTalkClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": "~26.2",
    "java": ">=25"
  }
}
